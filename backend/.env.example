# Copy to .env and edit. Never commit .env (it is gitignored).
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://root:CHANGE_ME@localhost:3306/soccer_analytics_app

# Comma-separated list of allowed frontend origins (Vite dev server defaults)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Auth ---
# Generate a real secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_a_long_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Uploads ---
# UPLOAD_DIR=uploads
MAX_UPLOAD_MB=500
ALLOWED_VIDEO_EXTENSIONS=mp4,mov,avi,mkv
# Thumbnails (ffmpeg on PATH, else opencv if installed; optional)
# THUMBNAILS_ENABLED=true
# Lifetime of the ?token= embedded in thumbnail_url (for <img> tags)
# THUMBNAIL_TOKEN_EXPIRE_MINUTES=60

# --- CV pipeline (PR #1: cv/run_pipeline.py) ---
# auto = real pipeline if CV_PIPELINE_PATH exists, else stub if CV_PIPELINE_STUB=true, else mark video failed
# real = always real pipeline, stub = always FAKE demo stats
CV_PIPELINE_MODE=auto
CV_PIPELINE_STUB=true
# Locates the CV checkout (path to cv/run_pipeline.py, the cv/ dir, or the repo root). Default ../cv/run_pipeline.py.
# The backend runs `python -m cv.run_pipeline` with cwd = PYTHONPATH = that repo root.
# CV_PIPELINE_PATH=/Users/you/path/to/repo/cv/run_pipeline.py
# Python with the CV deps installed (own venv, Python 3.11-3.13). Empty = backend's python.
# CV_PYTHON=/Users/you/path/to/repo/cv/venv/bin/python
CV_DEVICE=auto
# CV_MODEL=yolov8x.pt
# Optional. Without it pipeline v1.1.0 uses cv/config/default_calibration.json (approximate speed/distance).
# CV_CALIBRATION_PATH=/Users/you/path/to/repo/cv/config/example_calibration.json
# CV_EXTRA_ARGS=--ocr-sample-rate 10
CV_TIMEOUT_SECONDS=14400
# Player tracking (v0.5.0), independent of CV_PIPELINE_MODE:
#   auto = real only if cv/track_player.py AND cv/detect_frame.py exist under the CV repo root, else stub (fake demo)
#   real = always the CV tracking modules (tracks fail with error_code cv_unavailable if missing), stub = always fake
TRACK_PIPELINE_MODE=auto
# CV_TRACK_TIMEOUT_SECONDS=7200
# CV_DETECT_TIMEOUT_SECONDS=180
# MEDIA_TOKEN_EXPIRE_MINUTES=60
CV_CREATE_UNKNOWN_PLAYERS=true

# --- Health data + injury-risk dashboard (v0.7.0) ---
# AES-256-GCM key for heart rate + risk scores at rest: base64 of exactly 32 random bytes. Generate ON the server:
#   .venv/bin/python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Keep it secret and backed up: losing it makes stored heart rates / risk scores unreadable. Never commit it.
HEALTH_DATA_KEY=
# Risk levels: red >= RED, yellow >= YELLOW, else green
RISK_RED_THRESHOLD=70
RISK_YELLOW_THRESHOLD=40
# POST /api/uploads/csv limits
CSV_MAX_MB=5
CSV_MAX_ROWS=5000
# Set false ONLY for a second server process (HTTPS on 8443) so it never marks the HTTP process's jobs failed
STARTUP_RECOVERY=true
